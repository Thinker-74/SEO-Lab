# Prova loopback SEO Lab P0 sulla sola staging Netsons autorizzata (A-002).
# Compilare i valori in .env, ignorato da git. Questo esempio resta senza valori.
# Canale supportato per la prova: ssh con WP-CLI remoto.
SEO_LAB_STAGE_CHANNEL=
SEO_LAB_STAGE_SSH_HOST=
SEO_LAB_STAGE_SSH_PORT=
SEO_LAB_STAGE_SSH_USER=
# Chiave privata dedicata, codificata base64 su una sola riga.
SEO_LAB_STAGE_SSH_PRIVATE_KEY_B64=
# Record known_hosts verificato per l'host e la porta configurati.
SEO_LAB_STAGE_SSH_KNOWN_HOSTS=
# Percorso assoluto dell'installazione WordPress autorizzata.
SEO_LAB_STAGE_WP_PATH=
# ID di una pagina o di un articolo pubblico già esistente.
SEO_LAB_STAGE_PUBLIC_POST_ID=
